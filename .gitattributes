# Normalize all text files to LF in the repo and in the working tree.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary files: never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.exe  binary
*.dll  binary
*.lib  binary
*.pdb  binary
*.bin  binary
